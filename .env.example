# Copy to .env.local and fill in. .env.local is gitignored.
#
#   cp .env.example .env.local
#
# Everything except ANTHROPIC_API_KEY is required at boot — the app refuses to
# start with a readable message rather than failing mid-request later.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local Postgres:
#   docker run -d --rm --name trueline-pg -e POSTGRES_PASSWORD=test \
#     -e POSTGRES_DB=trueline -p 55432:5432 postgres:16-alpine
DATABASE_URL=postgres://postgres:test@localhost:55432/trueline
# Neon (note ?sslmode=require — the driver keys TLS off it):
# DATABASE_URL=postgres://user:pass@ep-xxx-pooler.eu-west-2.aws.neon.tech/trueline?sslmode=require

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Signs the session cookie. Minimum 32 characters. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Changing this invalidates every existing session.
SESSION_SECRET=replace-me-with-at-least-32-random-characters

# ---------------------------------------------------------------------------
# Claude API
# ---------------------------------------------------------------------------
# OPTIONAL at boot. Upload, list, and detail all work without it; only
# extraction needs it, and it fails with a specific message pointing here.
# Create one at:  https://platform.claude.com/settings/workspaces/default/keys
# (console.anthropic.com redirects here; platform.claude.com is canonical.)
#
# Keys, spend limits, and rate limits are all workspace-scoped. For anything
# with a public URL, create a dedicated workspace and cap its spend there —
# then a runaway loop drains one budget instead of the whole account.
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Tuning knobs — override to trade cost against quality without a code change.
# EXTRACTION_MODEL=claude-opus-5
# EXTRACTION_EFFORT=medium              # low | medium | high | xhigh | max
# EXTRACTION_MAX_TOKENS=16000           # covers thinking AND the response
# EXTRACTION_RETRY_MAX_TOKENS=32000     # used only on a truncation retry
# EXTRACTION_BUDGET_MS=50000            # must stay under the route's maxDuration (60s)

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Local filesystem for now. Swapping to Vercel Blob touches src/lib/storage only.
# STORAGE_DIR=.storage
